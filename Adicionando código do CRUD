produtos = []
class Produtos:
    def __init__(self, marca, modelo, preco, quantidade):
        self.marca = marca
        self.modelo = modelo
        self.preco = preco
        self.quantidade = quantidade

#Cadastrar produtos
marca = input("Digite a marca: ")
modelo = input("Digite o modelo: ")
preco = float(input("Digite o preço: "))
quantidade = int(input("Digite a quantidade: "))

#listar produtos
for i, produto in enumerate(produtos, start=1):
    print(f"{i} - {produto.marca} {produto.modelo}")

#atualizar produtos
    def atualizar_produto(self):
                    marca = input("Digite a marca do produto: ")
                    modelo = input("Digite o modelo do produto: ")

                    for produto in produtos:
                        if produto.marca == marca and produto.modelo == modelo:
                            produto.preco = float(input("Novo preço: "))
                            produto.quantidade = int(input("Nova quantidade: "))
                            print("Produto atualizado com sucesso!")
                            return

                    print("Produto não encontrado.")

#Adicionar produtos
    def adicionar_produto(self):
                    marca = input("Digite a marca do produto: ")
                    modelo = input("Digite o modelo do produto: ")

                    for produto in produtos:
                        if produto.marca == marca and produto.modelo == modelo:
                            quantidade_adicional = int(input("Quantidade a adicionar: "))
                            produto.quantidade += quantidade_adicional
                            print("Produto adicionado com sucesso!")
                            return

                    print("Produto não encontrado.")

#Buscar produtos
def buscar_produtos(produtos):
    marca = input("Digite a marca do produto: ")
    modelo = input("Digite o modelo do produto: ")

    for produto in produtos:
        if produto.marca == marca and produto.modelo == modelo:
            print(f"Marca: {produto.marca}")
            print(f"Modelo: {produto.modelo}")
            print(f"Preço: R$ {produto.preco}")
            print(f"Quantidade: {produto.quantidade}")
            return

    print("Produto não encontrado.")

#Excluir produtos
def excluir_produto(produtos):
    marca = input("Digite a marca do produto: ")
    modelo = input("Digite o modelo do produto: ")

    for produto in produtos:
        if produto.marca == marca and produto.modelo == modelo:
            produtos.remove(produto)
            print("Produto excluído com sucesso!")
            return

    print("Produto não encontrado.")

#Buscar produtos por marca
def buscar_produtos_por_marca(produtos):
    marca = input("Digite a marca do produto: ")
    encontrados = [produto for produto in produtos if produto.marca == marca]

    if encontrados:
        for produto in encontrados:
            print(f"Marca: {produto.marca}")
            print(f"Modelo: {produto.modelo}")
            print(f"Preço: R$ {produto.preco}")
            print(f"Quantidade: {produto.quantidade}")
    else:
        print("Nenhum produto encontrado para a marca informada.")

#Remover quantidade de produtos
def remover_quantidade_produto(produtos):
    marca = input("Digite a marca do produto: ")
    modelo = input("Digite o modelo do produto: ")

    for produto in produtos:
        if produto.marca == marca and produto.modelo == modelo:
            quantidade_remover = int(input("Quantidade a remover: "))
            if quantidade_remover <= produto.quantidade:
                produto.quantidade -= quantidade_remover
                print("Quantidade removida com sucesso!")
            else:
                print("Quantidade insuficiente em estoque.")
            return

    print("Produto não encontrado.")

#Sair do programa
def sair():
    print("Saindo do programa...")
    exit()

# Menu de opções
while True:
    print("\n1 - Cadastrar produto")
    print("2 - Listar produtos")
    print("3 - Atualizar produto")
    print("4 - Adicionar produto")
    print("5 - Buscar produto")
    print("6 - Excluir produto")
    print("7 - Buscar produtos por marca")
    print("8 - Remover quantidade de produto")
    print("9 - Sair")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        marca = input("Digite a marca: ")
        modelo = input("Digite o modelo: ")
        preco = float(input("Digite o preço: "))
        quantidade = int(input("Digite a quantidade: "))
        produto = Produtos(marca, modelo, preco, quantidade)
        produtos.append(produto)
        print("Produto cadastrado com sucesso!")

    elif opcao == "2":
        if not produtos:
            print("Nenhum produto cadastrado.")
        else:
            for i, produto in enumerate(produtos, start=1):
                print(f"{i} - {produto.marca} {produto.modelo}")

    elif opcao == "3":
        atualizar_produto(produtos)

    elif opcao == "4":
        adicionar_produto(produtos)

    elif opcao == "5":
        buscar_produtos(produtos)

    elif opcao == "6":
        excluir_produto(produtos)

    elif opcao == "7":
        buscar_produtos_por_marca(produtos)

    elif opcao == "8":
        remover_quantidade_produto(produtos)

    elif opcao == "9":
        sair()

    else:
        print("Opção inválida. Tente novamente.")
